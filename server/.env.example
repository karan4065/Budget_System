PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/budgetsystem?retryWrites=true&w=majority

# Single Admin Account (created automatically on first server startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword
ADMIN_NAME=Administrator
ADMIN_WHATSAPP_PHONE=9999999999

# Meta WhatsApp Business Cloud API Configuration (optional - simulated if not set)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_or_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v19.0

NODE_ENV=production
